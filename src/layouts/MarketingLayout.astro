---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MediCoder.AI | Risk Adjustment Intelligence",
  description = "Surface missed HCCs, calculate RAF scores, and close revenue gaps — from any clinical note, any format, any EHR.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/MediCoderAIInverted.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Manrope:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <slot />
    </div>
  </body>
</html>
