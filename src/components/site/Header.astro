---
import { BOOK_URL } from "../../lib/site";

const navItems = [
  { label: "How it works", href: "/how-it-works/" },
  { label: "Pricing", href: "/pricing/" },
  { label: "Security", href: "/security/" },
  { label: "FAQ", href: "/#faq" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/#faq" && path.startsWith(href.replace(/\/$/, ""));
---

<header class="site-header" id="site-header">
  <div class="bar container">
    <a href="/" class="brand" aria-label="MediCoder.AI home"><span class="brand-mark" aria-hidden="true"></span>MediCoder.AI</a>

    <nav class="desktop-nav" aria-label="Primary">
      {navItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-cta">Book a call</a>
      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book a call</a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");

  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    header?.classList.toggle("open", open);
    hamburger?.setAttribute("aria-expanded", String(open));
  };
  hamburger?.addEventListener("click", () => setOpen(!header?.classList.contains("open")));
  mobileMenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: rgba(250, 249, 247, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .site-header.scrolled,
  .site-header.open {
    border-bottom-color: var(--line);
  }

  .bar {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  /* Wordmark: regular weight, one colour. */
  .brand {
    justify-self: start;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .desktop-nav {
    display: flex;
    gap: 32px;
  }

  .desktop-nav a {
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta {
    height: 36px;
    padding: 0 16px;
    font-size: 14px;
  }

  .hamburger {
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .hamburger span {
    position: absolute;
    left: 11px;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .hamburger span:first-child { top: 16px; }
  .hamburger span:last-child { top: 23px; }
  .open .hamburger span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .open .hamburger span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 860px) {
    .bar {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .nav-cta {
      display: none;
    }

    .hamburger {
      display: block;
    }

    .mobile-menu {
      display: grid;
      gap: 4px;
      max-height: 0;
      overflow: hidden;
      padding: 0 var(--gutter);
      transition: max-height 0.45s var(--ease), padding 0.45s var(--ease);
    }

    .open .mobile-menu {
      max-height: 420px;
      padding: 8px var(--gutter) 24px;
    }

    .mobile-menu a:not(.btn) {
      padding: 12px 0;
      font-family: var(--font-display);
      font-size: 28px;
      letter-spacing: -0.02em;
      color: var(--ink);
      border-bottom: 1px solid var(--line);
    }

    .mobile-menu .btn {
      margin-top: 16px;
    }
  }
</style>
