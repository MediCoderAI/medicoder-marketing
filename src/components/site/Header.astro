---
const navItems = [
  { label: "How It Works", href: "#how-it-works" },
  { label: "Features", href: "#features" },
  { label: "Pricing", href: "#pricing" },
];
---

<header class="site-header">
  <div class="header-frame">
    <div class="nav-bar glass">
      <a href="#" class="brand">
        <img src="/MediCoderAIInverted.png" alt="" width="30" height="26" />
        <span>MediCoder.AI</span>
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <a href="https://calendly.com/samuel-han-medicoder/book-a-consultation"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta btn-dark">
        Book a call
        <span class="arrow-circle">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-inner">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="https://calendly.com/samuel-han-medicoder/book-a-consultation"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-dark mobile-cta">
        Book a call
        <span class="arrow-circle">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");

  hamburger?.addEventListener("click", () => {
    const open = mobileMenu?.classList.toggle("open");
    hamburger.classList.toggle("open", open);
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("open");
      hamburger?.classList.remove("open");
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    width: 100%;
    padding: 8px;
  }

  .header-frame {
    max-width: 1220px;
    margin: 0 auto;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-radius: 13px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-strong);
    font-family: var(--font-logo);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .brand img {
    border-radius: 6px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 50px;
    color: var(--ink-muted);
    font-size: 15px;
  }

  .desktop-nav a {
    transition: color var(--duration-fast);
  }

  .desktop-nav a:hover {
    color: var(--ink-strong);
  }

  .nav-cta {
    padding: 6px 6px 6px 18px !important;
    font-size: 14px !important;
  }

  .nav-cta .arrow-circle {
    width: 2.2rem;
    height: 2.2rem;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 12px;
    border: none;
    background: none;
    cursor: pointer;
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--accent-green);
    border-radius: 10px;
    transition: all 300ms var(--ease-standard);
  }

  .hamburger.open span:first-child {
    transform: rotate(45deg) translate(3px, 3px);
  }

  .hamburger.open span:last-child {
    transform: rotate(-45deg) translate(3px, -3px);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 72px;
    left: 8px;
    right: 8px;
    z-index: 49;
  }

  .mobile-menu.open {
    display: block;
    animation: fadeDown 300ms var(--ease-out);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: 20px;
    border-radius: 13px;
    background: var(--glass-nav);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line-subtle);
  }

  .mobile-menu a:not(.btn-dark) {
    padding: 8px 0;
    color: var(--ink-muted);
    font-size: 15px;
  }

  .mobile-cta {
    margin-top: 4px;
    justify-content: center;
  }

  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 809px) {
    .desktop-nav,
    .nav-cta {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .site-header {
      width: 95%;
    }
  }
</style>
