---
import ReadAlong from "../motion/ReadAlong.astro";
import { BOOK_URL, CONTACT_EMAIL } from "../../lib/site";

interface Props {
  text?: string;
  lede?: string;
}

const {
  text = "See what your [[notes are worth.|c]]",
  lede = "Upload your first notes free. No EHR integration, no commitment — just the revenue you've been leaving on the table.",
} = Astro.props;
---

<section class="cta section">
  <div class="container inner">
    <ReadAlong as="h2" text={text} size="xl" />
    <p class="lede">{lede}</p>
    <div class="actions">
      <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Start a free audit</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-ghost">{CONTACT_EMAIL}</a>
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .inner :global(.ra) {
    max-width: 12ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
