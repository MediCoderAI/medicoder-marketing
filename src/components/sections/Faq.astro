---
import { BOOK_URL, CONTACT_EMAIL } from "../../lib/site";

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  soft?: string;
}

const { items, title = "Your questions.", soft = "Answered." } = Astro.props;
---

<section class="faq section" id="faq">
  <div class="container grid">
    <div class="left">
      <p class="eyebrow">FAQ</p>
      <h2 class="h2">{title} <span class="muted">{soft}</span></h2>
      <p class="contact">
        Didn't find your answer? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or
        <a href={BOOK_URL} target="_blank" rel="noopener noreferrer">book a call</a>.
      </p>
    </div>

    <div class="list">
      {
        items.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .contact {
    margin: 8px 0 0;
    max-width: 340px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .contact a {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .list {
    border-top: 1px solid var(--line-strong);
  }

  details {
    border-bottom: 1px solid var(--line-strong);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 26px 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6.25px;
    width: 14px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--ink);
    transition: transform 0.35s var(--ease);
  }

  .icon::after {
    transform: rotate(90deg);
  }

  details[open] .icon::after {
    transform: rotate(0deg);
  }

  details p {
    margin: -8px 0 0;
    padding-bottom: 28px;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .left {
      position: static;
    }
  }
</style>
