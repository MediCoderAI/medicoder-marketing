---
import { BOOK_URL } from "../../lib/site";

const lines = [["Every", "note."], ["Every", "code."], ["Captured."]];
let i = 0;
---

<section class="hero" id="top">
  <div class="container inner">
    <p class="kicker fade" style="--d:-5">Risk adjustment intelligence for primary care</p>

    <h1 class="h1 title" aria-label="Every note. Every code. Captured.">
      {
        lines.map((line, li) => (
          <span class="line" aria-hidden="true">
            {line.map((w) => (
              <Fragment>
                <span class:list={["hw", { accent: li === lines.length - 1 }]} style={`--i:${i++}`}>{w}</span>{" "}
              </Fragment>
            ))}
          </span>
        ))
      }
    </h1>

    <p class="lede fade" style="--d:1">
      Find the revenue your clinical notes are leaving behind. Upload notes, surface missed HCCs and see the dollar
      impact — no EHR integration required.
    </p>

    <div class="actions fade" style="--d:2">
      <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Start a free audit</a>
      <a href="#read" class="btn btn-ghost">See it read a note</a>
    </div>
  </div>

  <a href="#read" class="cue fade" style="--d:3" aria-label="Scroll to the demo">
    <span></span>
  </a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const go = () => hero?.classList.add("go");
  if (document.querySelector("[data-intro]") && !document.documentElement.classList.contains("skip-intro")) {
    window.addEventListener("intro:done", go, { once: true });
    setTimeout(go, 4000);
  } else {
    go();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: max(92svh, 640px);
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
    padding-block: 72px 96px;
  }

  .kicker {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--green-lift);
  }

  .title {
    max-width: 12ch;
  }

  .line {
    display: block;
  }

  .hw {
    display: inline-block;
  }

  .hw.accent {
    color: var(--green);
    font-style: italic;
  }

  .lede {
    max-width: 600px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: 32px;
    translate: -50% 0;
    width: 22px;
    height: 36px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }

  .cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--ink-3);
    animation: wheel 1.8s var(--ease) infinite;
  }

  @keyframes wheel {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(10px); opacity: 0; }
    100% { opacity: 0; }
  }

  /* Load-in: words resolve from blur, one by one, after the intro. */
  :global(.js) .hw {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(0.18em);
  }

  :global(.js) .fade {
    opacity: 0;
    transform: translateY(12px);
  }

  .go .hw {
    animation: word-in 1s var(--ease) calc(var(--i) * 90ms + 150ms) forwards;
  }

  .go .fade {
    animation: fade-in 0.9s var(--ease) calc(var(--d) * 120ms + 800ms) forwards;
  }

  @keyframes word-in {
    to { opacity: 1; filter: blur(0); transform: none; }
  }

  @keyframes fade-in {
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 560px) {
    .actions {
      flex-direction: column;
      align-self: stretch;
    }

    .cue {
      display: none;
    }
  }
</style>
