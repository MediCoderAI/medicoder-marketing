---
import HeroDemo from "../motion/HeroDemo.svelte";
import Reveal from "../motion/Reveal.svelte";
---

<section class="hero" id="hero">
  <div class="container hero-inner">
    <!-- Left: Copy -->
    <Reveal client:load delay={100} distance={60} rotate={-12}>
      <div class="hero-copy">
        <h1 class="section-heading">
          Find the revenue your clinical notes are <em>leaving behind</em>
        </h1>

        <p class="section-copy">
          Upload notes. Surface missed HCCs. See the dollar impact. No EHR
          integration required — purpose-built risk adjustment intelligence for
          primary care.
        </p>

        <div class="hero-actions">
          <a href="#pricing" class="btn-pill">
            Upload Notes Free
            <span class="arrow-circle">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
          <a href="#how-it-works" class="btn-outline">See How It Works</a>
        </div>

        <div class="trust-row">
          <span class="trust-item">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            HIPAA Compliant
          </span>
          <span class="trust-item">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            No EHR Integration
          </span>
        </div>
      </div>
    </Reveal>

    <!-- Right: Demo Card (constrained width) -->
    <Reveal client:load delay={300} distance={80} rotate={-16}>
      <div class="hero-visual">
        <HeroDemo client:load />
      </div>
    </Reveal>
  </div>
</section>

<!-- Services band -->
<section class="services-band" id="how-it-works">
  <div class="container">
    <Reveal client:visible delay={0} distance={60} rotate={-10}>
      <div class="services-divider"></div>
      <div class="services-header">
        <h2 class="services-title"><strong>Simple &amp; Powerful</strong></h2>
        <p class="section-copy">
          From clinical notes to revenue impact — upload notes in any format,
          get back HCC gaps, RAF scores, and dollar impact in seconds, not weeks.
        </p>
      </div>
      <div class="services-grid">
        <article class="service-card">
          <span class="step-num">Step 01</span>
          <div class="service-icon icon-a">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3>Upload Clinical Notes</h3>
          <p>Upload notes from any EHR, any format — PDFs, text, dictation exports. Single or batch.</p>
        </article>
        <article class="service-card">
          <span class="step-num">Step 02</span>
          <div class="service-icon icon-b">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3>AI-Powered Analysis</h3>
          <p>Surface missed HCCs, calculate RAF scores under V28, and identify documentation gaps.</p>
        </article>
        <article class="service-card">
          <span class="step-num">Step 03</span>
          <div class="service-icon icon-c">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3>Revenue Impact Report</h3>
          <p>Get captured vs. missed HCCs, RAF score impact, and estimated revenue per member.</p>
        </article>
      </div>
    </Reveal>
  </div>
</section>

<!-- Stats band -->
<section class="stats-band">
  <div class="container">
    <Reveal client:visible delay={0} distance={130} rotate={-30}>
      <div class="stats-grid">
        <div class="stat-card card-dark">
          <span class="stat-label">Zero EHR integration</span>
          <div class="stat-number">0<span class="stat-suffix">setup</span></div>
        </div>
        <div class="stat-card card-dark">
          <span class="stat-label">V28 model-native from day one</span>
          <div class="stat-number">V28<span class="stat-suffix">ready</span></div>
        </div>
        <div class="stat-card card-dark">
          <span class="stat-label">Results in seconds, not weeks</span>
          <div class="stat-number">&lt;3<span class="stat-suffix">min</span></div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  /* ─── Hero ─── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 120px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    padding: 40px 0 60px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 520px;
  }

  .hero-visual {
    max-width: 540px;
    width: 100%;
    justify-self: end;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding-top: 8px;
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .trust-item svg {
    color: var(--accent-green);
    flex-shrink: 0;
  }

  /* ─── Services band ─── */
  .services-band {
    padding: 0 0 80px;
  }

  .services-divider {
    height: 1px;
    background: var(--line-subtle);
    margin-bottom: 60px;
  }

  .services-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .services-header :global(.section-copy) {
    max-width: 680px;
  }

  .services-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(30px, 2.2vw + 16px, 50px);
    color: var(--ink-strong);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .services-title strong {
    font-weight: 700;
  }

  .services-grid {
    display: grid;
    gap: 20px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    padding: 40px 28px 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-subtle);
    background: rgba(255, 255, 255, 0.45);
    transition: all var(--duration-base) var(--ease-standard);
  }

  .service-card:hover {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: var(--shadow-soft);
    transform: translateY(-4px);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-green);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .service-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 300ms;
  }

  .icon-a {
    background: rgba(209, 234, 103, 0.2);
    color: #3d5a0a;
  }

  .icon-b {
    background: rgba(26, 49, 42, 0.1);
    color: var(--accent-green);
  }

  .icon-c {
    background: rgba(99, 163, 255, 0.12);
    color: #1d4ed8;
  }

  .service-card:hover .icon-a { box-shadow: 0 0 20px rgba(209, 234, 103, 0.4); }
  .service-card:hover .icon-b { box-shadow: 0 0 20px rgba(26, 49, 42, 0.25); }
  .service-card:hover .icon-c { box-shadow: 0 0 20px rgba(99, 163, 255, 0.3); }

  .service-card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--ink-strong);
  }

  .service-card p {
    margin: 0;
    color: var(--ink-base);
    line-height: 1.55;
    max-width: 260px;
  }

  /* ─── Stats band ─── */
  .stats-band {
    padding-bottom: 100px;
  }

  .stats-grid {
    display: grid;
    gap: 20px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 100px;
    min-height: 220px;
  }

  .stat-label {
    font-size: 15px;
    color: var(--ink-white);
  }

  .stat-number {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-body);
    font-size: clamp(64px, 5vw + 30px, 100px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: var(--ink-white);
  }

  .stat-suffix {
    font-family: var(--font-heading);
    font-size: clamp(20px, 2vw + 10px, 32px);
    font-weight: 500;
    color: var(--accent-lime);
    letter-spacing: 0em;
  }

  @media (min-width: 810px) {
    .services-grid,
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 809px) {
    .hero {
      min-height: auto;
      padding-top: 100px;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 20px 0 40px;
    }

    .hero-visual {
      max-width: 100%;
      justify-self: stretch;
    }

    .stat-card {
      gap: 40px;
      min-height: auto;
    }
  }
</style>
