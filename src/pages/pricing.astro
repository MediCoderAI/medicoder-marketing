---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import Pricing from "../components/sections/Pricing.astro";
import Faq from "../components/sections/Faq.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { faqs } from "../lib/content";
---

<MarketingLayout
  title="Pricing | MediCoder.AI"
  description="Start with a free 25-chart audit. Plans for solo practitioners, growing practices, billing companies, MSOs and IPAs."
>
  <PageHero
    eyebrow="Pricing"
    title="Start with a free"
    soft="25-chart audit."
    lede="From solo practitioners to large organizations, find the plan that fits your practice. No credit card to start."
  />
  <Pricing showHead={false} />
  <Faq items={[faqs.audit, faqs.noIntegration, faqs.ffs, faqs.pfs, faqs.hipaa, faqs.baa]} title="Pricing questions." />
  <CtaBand />
</MarketingLayout>
